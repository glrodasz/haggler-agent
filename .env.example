# Copy to .env (cp .env.example .env). `haggler ...` loads ./.env from the working directory and
# `adk web agents` loads the repo-root .env; variables already set in the environment win.
# The Cloud Run Job does not use this file: deploy-job.yml sets its environment.

# --- LLM (Gemini): uncomment EXACTLY ONE of the two blocks below. ---
# With neither, the LLM fallback is off (deterministic parsers only). Do not enable both: in
# Vertex mode google-genai ignores GOOGLE_API_KEY and calls Vertex AI with GOOGLE_CLOUD_PROJECT.
#
# A) Local development with a Google AI Studio key:
# GOOGLE_API_KEY=your-ai-studio-key
#
# B) Vertex AI with Application Default Credentials (gcloud auth application-default login),
#    as in production:
# GOOGLE_GENAI_USE_ENTERPRISE=1
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=global

HAGGLER_EXTRACT_MODEL=gemini-3.1-flash-lite
# HAGGLER_LLM=off            # disable LLM fallback entirely
# HAGGLER_MAX_LLM_CALLS=150  # model calls per run; 0 or less turns the LLM off
# HAGGLER_LLM_JOB_TIMEOUT_S=120

# --- Feasibility research (haggler research run; Gemini + Google Search) ---
# HAGGLER_RESEARCH_MODEL=gemini-3-flash-preview
# HAGGLER_RESEARCH_MAX_CALLS=40            # model calls per run
# HAGGLER_RESEARCH_MAX_QUERIES=200         # search queries per run (grounding metadata)
# HAGGLER_RESEARCH_MAX_MONTH_QUERIES=1500  # monthly guard (grounding is billed past the free tier)
# HAGGLER_RESEARCH_MAX_PAIRS=6
# HAGGLER_RESEARCH_MAX_SERVICES=3
# HAGGLER_RESEARCH_MAX_INSTRUMENTS=2
# HAGGLER_RESEARCH_MAX_BUNDLES=2           # bundle subjects per run, researched after all others

# --- Bundle watcher (inside haggler research run; no LLM, 0 search queries; docs/SETUP.md §14) ---
# HAGGLER_BUNDLE_WATCH_MAX_PAGES=40        # distinct URLs per run (index pages and PDFs included)

# --- Storage ---
HAGGLER_STORE=local          # local | gcs | memory
# HAGGLER_LOCAL_DIR=.haggler
# HAGGLER_GCS_BUCKET=your-project-haggler-data

# --- Etiquette ---
# HAGGLER_PER_HOST_INTERVAL_S=3
# HAGGLER_USER_AGENT="haggler-agent/0.1 (+https://github.com/glrodasz/haggler-agent)"

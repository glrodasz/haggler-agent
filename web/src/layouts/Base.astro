---
import "@fontsource-variable/inter";
import "../styles/global.css";
import LogoMark from "../components/LogoMark.astro";
import { es } from "../i18n/es";
import { getSite } from "../logic/data";
import { formatDate, formatDateTime } from "../logic/format";
import { routes, withBase } from "../logic/paths";

type NavKey = keyof typeof es.site.nav;

interface Props {
  title?: string;
  description?: string;
  current?: NavKey;
  /** Landing layout: full-bleed sections instead of one centred column. */
  wide?: boolean;
  /** false for pages served at arbitrary URLs (404): no canonical link, not indexed. */
  indexable?: boolean;
}

const site = getSite();
const {
  title,
  description = es.site.description(site.residenceName),
  current,
  indexable = true,
  wide = false,
} = Astro.props;
const fullTitle = title ? `${title} · ${es.site.name}` : `${es.site.name} · ${es.site.tagline}`;
const canonical =
  indexable && Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// Social networks need absolute image URLs.
const ogImage = new URL(withBase("og/haggler.png"), Astro.site ?? Astro.url).href;

const dataLabel = site.isSample
  ? es.site.sampleData
  : es.site.dataAsOfShort(formatDate(site.meta.as_of));

const nav: { key: NavKey; href: string }[] = [
  { key: "home", href: routes.home() },
  { key: "services", href: routes.services() },
  { key: "countries", href: routes.countries() },
  { key: "bundles", href: routes.bundles() },
  { key: "changes", href: routes.changes() },
  { key: "methodology", href: routes.methodology() },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={withBase("favicon-32.png")} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase("apple-touch-icon.png")} />
    <link rel="manifest" href={withBase("site.webmanifest")} />
    {canonical && <link rel="canonical" href={canonical} />}
    {!indexable && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={es.site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_ES" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={es.site.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={es.site.ogImageAlt} />
  </head>
  <body>
    <a class="skip-link" href="#main">{es.site.skipToContent}</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={routes.home()}>
          <LogoMark size={34} />
          <span class="wordmark">{es.site.name}</span>
        </a>
        <nav class="site-nav" aria-label={es.site.navLabel}>
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.key === current ? "page" : undefined}>
                    {es.site.nav[item.key]}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    {
      site.isSample && (
        <div class="banner" role="note">
          <div class="container">{es.site.sampleBanner}</div>
        </div>
      )
    }
    <main id="main" class:list={[wide ? "is-wide" : "container page"]} tabindex="-1">
      {!wide && <p class="page-eyebrow">{es.site.pageEyebrow(dataLabel)}</p>}
      <slot />
      {
        !wide && current !== "home" && (
          <p class="page-back">
            <a class="button button-ghost" href={routes.home()}>
              <span aria-hidden="true">←</span> {es.site.backToCompare}
            </a>
          </p>
        )
      }
    </main>
    <footer class="site-footer">
      <div class="container">
        <p class="footer-brand">
          <LogoMark size={30} />
          <span class="wordmark">{es.site.name}</span>
        </p>
        <p class="footer-tagline">{es.site.tagline}.</p>
        <p class="footer-disclaimer"><strong>{es.site.footer.disclaimer}</strong></p>
        <hr />
        <p>
          {es.site.footer.dataAsOf(formatDate(site.meta.as_of), site.meta.run_id)} ·{" "}
          {es.site.footer.generatedAt(formatDateTime(site.meta.generated_at))}
        </p>
        <p>
          <a href={routes.methodology()}>{es.site.footer.methodologyLink}</a> · {es.site.footer.noAnalytics}
        </p>
      </div>
    </footer>
  </body>
</html>

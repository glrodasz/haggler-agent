---
import "@fontsource-variable/inter";
import "../styles/global.css";
import LanguageMenu from "../components/LanguageMenu.astro";
import LogoMark from "../components/LogoMark.astro";
import { getMessages, type Messages } from "../i18n";
import { localeBootScript } from "../i18n/bootScript";
import { alternateLinks, LOCALES, localizePath, OG_LOCALES } from "../i18n/locale";
import { getSite } from "../logic/data";
import { localeOfUrl, routesFor, stripBase, withBase } from "../logic/paths";

type NavKey = keyof Messages["site"]["nav"];

interface Props {
  title?: string;
  description?: string;
  current?: NavKey;
  /** Landing layout: full-bleed sections instead of one centred column. */
  wide?: boolean;
  /** false for pages served at arbitrary URLs (404): no canonical link, not indexed. */
  indexable?: boolean;
}

const locale = localeOfUrl(Astro.url);
const site = getSite(locale);
const msg = getMessages(locale);
const routes = routesFor(locale);
const { formatDate, formatDateTime } = site.fmt;
const {
  title,
  description = msg.site.description(site.residenceName),
  current,
  indexable = true,
  wide = false,
} = Astro.props;
const fullTitle = title ? `${title} · ${msg.site.name}` : `${msg.site.name} · ${msg.site.tagline}`;
const canonical =
  indexable && Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// Every page exists in every locale under the same path, so each one lists all of them.
const bare = stripBase(Astro.url.pathname);
const alternates =
  indexable && Astro.site
    ? alternateLinks(
        bare,
        Astro.site.href,
        Object.fromEntries(LOCALES.map((l) => [l, withBase(localizePath(bare, l))])),
      )
    : [];
const bootScript = await localeBootScript();
// Social networks need absolute image URLs.
const ogImage = new URL(withBase("og/haggler.png"), Astro.site ?? Astro.url).href;

const dataLabel = site.isSample
  ? msg.site.sampleData
  : msg.site.dataAsOfShort(formatDate(site.meta.as_of));

const nav: { key: NavKey; href: string }[] = [
  { key: "home", href: routes.home() },
  { key: "services", href: routes.services() },
  { key: "countries", href: routes.countries() },
  { key: "bundles", href: routes.bundles() },
  { key: "changes", href: routes.changes() },
  { key: "methodology", href: routes.methodology() },
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <script is:inline data-base={import.meta.env.BASE_URL} set:html={bootScript} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={withBase("favicon-32.png")} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase("apple-touch-icon.png")} />
    <link rel="manifest" href={withBase("site.webmanifest")} />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {!indexable && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={msg.site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    {
      LOCALES.filter((l) => l !== locale).map((l) => (
        <meta property="og:locale:alternate" content={OG_LOCALES[l]} />
      ))
    }
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={msg.site.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={msg.site.ogImageAlt} />
  </head>
  <body>
    <a class="skip-link" href="#main">{msg.site.skipToContent}</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={routes.home()}>
          <LogoMark size={34} />
          <span class="wordmark">{msg.site.name}</span>
        </a>
        <nav class="site-nav" aria-label={msg.site.navLabel}>
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.key === current ? "page" : undefined}>
                    {msg.site.nav[item.key]}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    {
      site.isSample && (
        <div class="banner" role="note">
          <div class="container">{msg.site.sampleBanner}</div>
        </div>
      )
    }
    <main id="main" class:list={[wide ? "is-wide" : "container page"]} tabindex="-1">
      {!wide && <p class="page-eyebrow">{msg.site.pageEyebrow(dataLabel)}</p>}
      <slot />
      {
        !wide && current !== "home" && (
          <p class="page-back">
            <a class="button button-ghost" href={routes.home()}>
              <span aria-hidden="true">←</span> {msg.site.backToCompare}
            </a>
          </p>
        )
      }
    </main>
    <footer class="site-footer">
      <div class="container">
        <p class="footer-brand">
          <LogoMark size={30} />
          <span class="wordmark">{msg.site.name}</span>
        </p>
        <p class="footer-tagline">{msg.site.tagline}.</p>
        <p class="footer-disclaimer"><strong>{msg.site.footer.disclaimer}</strong></p>
        <hr />
        <div class="footer-bottom">
          <div>
            <p>
              {msg.site.footer.dataAsOf(formatDate(site.meta.as_of), site.meta.run_id)} ·{" "}
              {msg.site.footer.generatedAt(formatDateTime(site.meta.generated_at))}
            </p>
            <p>
              <a href={routes.methodology()}>{msg.site.footer.methodologyLink}</a> · {msg.site.footer.noAnalytics}
            </p>
          </div>
          <LanguageMenu />
        </div>
      </div>
    </footer>
  </body>
</html>

---
import "../styles/global.css";
import { es } from "../i18n/es";
import { getSite } from "../logic/data";
import { formatDate, formatDateTime } from "../logic/format";
import { routes, withBase } from "../logic/paths";

type NavKey = keyof typeof es.site.nav;

interface Props {
  title?: string;
  description?: string;
  current?: NavKey;
  /** false for pages served at arbitrary URLs (404): no canonical link, not indexed. */
  indexable?: boolean;
}

const { title, description = es.site.description, current, indexable = true } = Astro.props;
const site = getSite();
const fullTitle = title ? `${title} · ${es.site.name}` : `${es.site.name} · ${es.site.tagline}`;
const canonical =
  indexable && Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

const nav: { key: NavKey; href: string }[] = [
  { key: "home", href: routes.home() },
  { key: "services", href: routes.services() },
  { key: "countries", href: routes.countries() },
  { key: "changes", href: routes.changes() },
  { key: "methodology", href: routes.methodology() },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f6f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1d24" media="(prefers-color-scheme: dark)" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    {!indexable && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_ES" />
    {canonical && <meta property="og:url" content={canonical} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{es.site.skipToContent}</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={routes.home()}>{es.site.name}</a>
        <nav class="site-nav" aria-label={es.site.navLabel}>
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.key === current ? "page" : undefined}>
                    {es.site.nav[item.key]}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    {
      site.isSample && (
        <div class="banner" role="note">
          <div class="container">{es.site.sampleBanner}</div>
        </div>
      )
    }
    <main id="main" class="container" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p><strong>{es.site.footer.disclaimer}</strong></p>
        <p>
          {es.site.footer.dataAsOf(formatDate(site.meta.as_of), site.meta.run_id)} ·{" "}
          {es.site.footer.generatedAt(formatDateTime(site.meta.generated_at))}
        </p>
        <p>
          <a href={routes.methodology()}>{es.site.footer.methodologyLink}</a> · {es.site.footer.noAnalytics}
        </p>
      </div>
    </footer>
  </body>
</html>

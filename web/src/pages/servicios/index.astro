---
import CountryLabel from "../../components/CountryLabel.astro";
import { ServiceMark } from "../../components/ServiceMark";
import TableWrap from "../../components/TableWrap.astro";
import { es, lookup } from "../../i18n/es";
import Base from "../../layouts/Base.astro";
import { getSite } from "../../logic/data";
import { formatMoney } from "../../logic/format";
import { routes } from "../../logic/paths";
import { RISK_LEVELS, type RiskKey } from "../../logic/types";

const site = getSite();
const t = es.servicesIndex;
const services = [...site.services].sort((a, b) => a.name.localeCompare(b.name, "es"));
const rowFor = (id: string, plan: string) =>
  site.cheapest.find((r) => r.service_id === id && r.plan_id === plan);
const countriesWith = (id: string) => new Set(site.offersForService(id).map((o) => o.country)).size;
---

<Base title={t.title} current="services">
  <h1>{t.heading}</h1>
  <p class="lead">{t.lead}</p>
  <TableWrap captionId="servicios-caption">
    <table>
      <caption id="servicios-caption">{t.caption}</caption>
      <thead>
        <tr>
          <th scope="col">{t.colService}</th>
          <th scope="col">{t.colCategory}</th>
          <th scope="col" class="num">{t.colCountries}</th>
          <th scope="col">{t.colDefaultPlan}</th>
          <th scope="col" class="num">{t.colHome(site.residenceName)}</th>
          {RISK_LEVELS.slice(1).map((k) => <th scope="col">{t.colRisk(k)}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          services.map((s) => {
            const row = rowFor(s.id, s.default_plan);
            return (
              <tr>
                <th scope="row">
                  <span class="service-title">
                    <ServiceMark id={s.id} name={s.name} />
                    <a href={routes.service(s.id)}>{s.name}</a>
                  </span>
                </th>
                <td>{lookup(es.categories, s.category)}</td>
                <td class="num">{countriesWith(s.id)}</td>
                <td>{site.planLabel(s.id, s.default_plan)}</td>
                <td class="num">{formatMoney(row?.home?.cost_eur_with_fee, "EUR")}</td>
                {RISK_LEVELS.slice(1).map((k) => {
                  const best = row?.best_by_risk[`${k}` as RiskKey] ?? null;
                  return (
                    <td class="nowrap">
                      {best ? (
                        <>
                          <CountryLabel cc={best.country} link={false} />{" "}
                          <span class="num">{formatMoney(best.cost_eur_with_fee, "EUR")}</span>
                        </>
                      ) : (
                        "—"
                      )}
                    </td>
                  );
                })}
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </TableWrap>
</Base>

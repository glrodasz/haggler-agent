---
import BundleCard from "../../components/BundleCard.astro";
import ChannelBadge from "../../components/ChannelBadge.astro";
import CountryLabel from "../../components/CountryLabel.astro";
import EuBadge from "../../components/EuBadge.astro";
import FeasibilityTable from "../../components/FeasibilityTable.astro";
import OfferTable from "../../components/OfferTable.astro";
import ProfileNote from "../../components/ProfileNote.astro";
import ProfileFeasibility from "../../islands/ProfileFeasibility";
import RiskBadge from "../../components/RiskBadge.astro";
import { ServiceMark } from "../../components/ServiceMark";
import TableWrap from "../../components/TableWrap.astro";
import { es, lookup } from "../../i18n/es";
import Base from "../../layouts/Base.astro";
import { getSite } from "../../logic/data";
import { formatDate, formatMoney, formatSignedMoney } from "../../logic/format";
import { routes } from "../../logic/paths";
import { RISK_LEVELS, type RiskKey, type ServiceInfo } from "../../logic/types";

export function getStaticPaths() {
  return getSite().services.map((service) => ({ params: { id: service.id }, props: { service } }));
}

interface Props {
  service: ServiceInfo;
}

const { service } = Astro.props;
const site = getSite();
const t = es.service;
const offers = site.offersForService(service.id);
const bundles = site.bundlesForService(service.id);
const discountBundles = site.discountBundlesForService(service.id);
const records = site.feasibilityForService(service.id);
const summary = site.cheapest.find(
  (r) => r.service_id === service.id && r.plan_id === service.default_plan,
);
const defaultPlan = site.planLabel(service.id, service.default_plan);
---

<Base
  title={es.site.seo.serviceTitle(service.name)}
  description={es.site.seo.serviceDescription(
    service.name,
    new Set(site.offersForService(service.id).map((o) => o.country)).size,
  )}
  current="services"
>
  <p class="small"><a href={routes.services()}>← {t.backToServices}</a></p>
  <h1 class="service-title">
    <ServiceMark id={service.id} name={service.name} />
    {service.name}
  </h1>
  <ul class="facts">
    <li>{t.category}: <strong>{lookup(es.categories, service.category)}</strong></li>
    <li>{t.defaultPlan}: <strong>{defaultPlan}</strong></li>
    <li>{t.geoClass}: <strong>{lookup(es.euGeoClass, service.eu_geo_class)}</strong></li>
    <li><a href={service.homepage} rel="nofollow noopener noreferrer external">{t.homepage}</a></li>
  </ul>
  <ProfileNote />
  {
    service.notes_es && (
      <aside class="callout" aria-label={t.notesTitle}>
        <p>{service.notes_es}</p>
      </aside>
    )
  }

  {
    summary && (
      <section aria-labelledby="resumen">
        <h2 id="resumen">{t.summaryTitle}</h2>
        <TableWrap captionId="resumen-caption">
          <table
            data-profile-summary
            data-service={service.id}
            data-plan={service.default_plan}
          >
            <caption id="resumen-caption">{t.summaryCaption(defaultPlan)}</caption>
            <thead>
              <tr>
                <th scope="col">{t.colRisk}</th>
                <th scope="col">{t.colOffer}</th>
                <th scope="col" class="num">{t.colCost}</th>
                <th scope="col" class="num" data-cell="saving-head">
                  {t.colSaving(site.residenceName)}
                </th>
              </tr>
            </thead>
            <tbody>
              {RISK_LEVELS.map((k) => {
                const key = `${k}` as RiskKey;
                const best = summary.best_by_risk[key];
                const info = site.label(site.acceptableLabels()[k]?.id ?? "", k);
                return (
                  <tr data-level={k}>
                    <th scope="row">
                      {es.riskLevel(k)} · {info.name}
                    </th>
                    <td data-cell="offer">
                      {best ? (
                        <span class="badges">
                          <CountryLabel cc={best.country} />
                          <ChannelBadge channel={best.channel} />
                          <RiskBadge label={best.label} rank={best.rank} />
                          {best.eu_badge && <EuBadge />}
                        </span>
                      ) : (
                        "—"
                      )}
                    </td>
                    <td class="num" data-cell="cost">
                      {formatMoney(best?.cost_eur_with_fee, "EUR")}
                    </td>
                    <td class="num" data-cell="saving">
                      {formatSignedMoney(summary.savings_month_eur[key], "EUR")}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </TableWrap>
      </section>
    )
  }

  <section aria-labelledby="ofertas">
    <h2 id="ofertas">{t.offersTitle}</h2>
    {
      offers.length === 0 ? (
        <p>{t.noOffers}</p>
      ) : (
        <>
          <OfferTable
            offers={offers}
            mode="service"
            caption={t.offersCaption(service.name)}
            captionId="ofertas-caption"
          />
          <p class="note">
            {t.convNote(formatDate(site.fx.as_of))} {t.updatedNote(formatDate(site.meta.as_of))}
          </p>
        </>
      )
    }
  </section>

  <section aria-labelledby="factibilidad">
    <ProfileFeasibility
      client:load
      mode="service"
      subject={service.id}
      defaultResidenceName={site.residenceName}
      defaultProfile={site.feasibility.default_profile}
      names={Object.fromEntries(site.services.map((x) => [x.id, x.name]))}
    >
      <h2 id="factibilidad">{t.feasibilityTitle(site.residenceName)}</h2>
      {
        records.length === 0 ? (
          <p>{t.noFeasibility(site.residenceName)}</p>
        ) : (
          <>
            <p class="note">
              {t.feasibilityLead(site.residenceName, site.defaultProfile?.name_es)}
            </p>
            <FeasibilityTable
              records={records}
              mode="service"
              caption={`${t.feasibilityTitle(site.residenceName)}: ${service.name}`}
              captionId="factibilidad-caption"
            />
          </>
        )
      }
    </ProfileFeasibility>
  </section>

  <section aria-labelledby="paquetes">
    <h2 id="paquetes">{t.bundlesTitle}</h2>
    {
      bundles.length === 0 ? (
        <p>{t.noBundles}</p>
      ) : (
        <ul class="cards">
          {bundles.map((b) => (
            <BundleCard bundle={b} />
          ))}
        </ul>
      )
    }
  </section>

  {
    discountBundles.length > 0 && (
      <section aria-labelledby="paquetes-descuento">
        <h2 id="paquetes-descuento">{t.discountBundlesTitle}</h2>
        <p class="note">{t.discountBundlesLead}</p>
        <ul class="cards">
          {discountBundles.map((b) => (
            <BundleCard bundle={b} />
          ))}
        </ul>
      </section>
    )
  }
</Base>

---
import LegacyRedirect from "../../components/LegacyRedirect.astro";
import { getSite } from "../../logic/data";
import { routesFor } from "../../logic/paths";

export function getStaticPaths() {
  return getSite().services.map((s) => ({ params: { id: s.id } }));
}

const { id } = Astro.params;
---

<LegacyRedirect to={routesFor("es").service(id)} />

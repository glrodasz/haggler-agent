---
import Comparador, {
  type ComparadorCountry,
  type ComparadorLabel,
  type ComparadorProfile,
  type ComparadorResidence,
  type ComparadorService,
} from "../islands/Comparador";
import HeroSavings from "../islands/HeroSavings";
import { es } from "../i18n/es";
import Icon from "../components/Icon.astro";
import LogoMark from "../components/LogoMark.astro";
import Base from "../layouts/Base.astro";
import { type CompareOfferFields, isCandidate } from "../logic/compare";
import { getSite } from "../logic/data";
import { formatDate } from "../logic/format";
import { routes } from "../logic/paths";
import { countryOptions } from "../logic/profile";
import { inlineJson, packOffers } from "../logic/transport";

const site = getSite();
const t = es.home;

// Only candidates travel to the browser, and only the fields the comparison needs.
const offers: CompareOfferFields[] = site.offers.filter(isCandidate).map((o) => ({
  obs_key: o.obs_key,
  service_id: o.service_id,
  plan_id: o.plan_id,
  country: o.country,
  channel: o.channel,
  currency: o.currency,
  amount: o.amount,
  billing_period: o.billing_period,
  monthly_equiv: o.monthly_equiv,
  source_kind: o.source_kind,
  status: o.status,
  label: o.label,
  rank: o.rank,
  eu_badge: o.eu_badge,
}));
const plansWithOffers = new Set(offers.map((o) => `${o.service_id}:${o.plan_id}`));

const services: ComparadorService[] = site.pricedServices().map((s) => ({
  id: s.id,
  name: s.name,
  default_plan: s.default_plan,
  plans: [...s.plans]
    .filter((p) => p.id === s.default_plan || plansWithOffers.has(`${s.id}:${p.id}`))
    .sort((a, b) => a.rank - b.rank)
    .map((p) => ({ id: p.id, label_es: p.label_es })),
  href: routes.service(s.id),
}));

const labelIds = new Set([
  ...Object.keys(es.riskLabels),
  ...site.feasibility.labels.map((l) => l.id),
  ...site.offers.map((o) => o.label),
  ...site.feasibility.records.map((r) => r.label),
]);
const labels: Record<string, ComparadorLabel> = Object.fromEntries(
  [...labelIds].map((id) => [id, site.label(id)]),
);
const riskOptions: ComparadorLabel[] = site.acceptableLabels();
const countryNames = Object.fromEntries(site.countries.map((c) => [c.cc, c.name_es]));
const currencies = site.meta.display_currencies?.length ? site.meta.display_currencies : ["EUR"];
const defaultCurrency = currencies.includes(site.residenceCurrency)
  ? site.residenceCurrency
  : (currencies[0] ?? "EUR");
const offersJson = inlineJson(packOffers(offers));

// The public profiles and the rules of every pair, so the island can relabel the offers for a
// curated profile or one the visitor describes.
const profiles: ComparadorProfile[] = site.feasibility.profiles.map((p) => ({
  id: p.id,
  name: p.name_es,
  description: p.description_es,
  capabilities: p.capabilities,
}));
// Only countries with prices are offered, to live in (the saving is against its home price) or
// as ties (a tie with any other country unlocks no offer). Before the first prices, the catalog.
const priced = new Set(offers.map((o) => o.country));
const covered = site.countries
  .map((c) => c.cc)
  .filter((cc) => priced.size === 0 || priced.has(cc));
const residences: ComparadorResidence[] = countryOptions(covered, countryNames).map((o) => ({
  ...o,
  currency: site.country(o.cc)?.currency ?? "EUR",
}));
const tieCountries: ComparadorCountry[] = countryOptions(covered, countryNames);
const verdictsJson = inlineJson({ rules: site.feasibility.rules });

const [before, after] = t.heroTitle.split(t.heroAccent);
---

<Base current="home" wide>
  <section class="hero" aria-labelledby="hero-titulo">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow eyebrow-dot">{t.eyebrow}</p>
        <h1 id="hero-titulo" class="hero-title dotted">
          {before}<span class="accent">{t.heroAccent}</span>{after}
        </h1>
        <HeroSavings
          client:load
          services={services}
          residences={residences}
          tieCountries={tieCountries.map((c) => c.cc)}
          countryNames={countryNames}
          rates={site.fx.rates}
          feePct={site.meta.fx_fee_pct}
          residence={site.meta.residence}
          profiles={profiles.map((p) => ({ id: p.id, capabilities: p.capabilities }))}
          defaultProfile={site.feasibility.default_profile}
          eeaCountries={site.feasibility.eea_countries}
          dataId="comparador-ofertas"
          verdictsId="comparador-veredictos"
          targetId="comparar"
        />
        <p class="lead">{t.lead(site.residenceName)}</p>
        <div class="hero-actions">
          <a class="button button-light" href="#comparar">
            {t.ctaStart} <span aria-hidden="true">↓</span>
          </a>
          <a class="button button-link" href={routes.methodology()}>
            {t.ctaMethod} <span aria-hidden="true">↗</span>
          </a>
        </div>
        <ul class="hero-stats">
          <li>{t.stats.services(services.length)}</li>
          <li>{t.stats.countries(priced.size)}</li>
          <li>{t.stats.asOf(formatDate(site.meta.as_of))}</li>
        </ul>
      </div>
      <div class="hero-art" aria-hidden="true">
        <LogoMark size="100%" class="hero-mark" />
      </div>
    </div>
    <div class="workflow">
      <div class="container">
        <p class="workflow-title"><Icon name="agent" size={16} /> {t.workflowTitle}</p>
        <ol class="workflow-steps">
          {
            t.workflow.map((w, i) => (
              <li>
                <span class="workflow-icon">
                  <Icon name={(["search", "shield", "coins"] as const)[i] ?? "search"} size={16} />
                </span>
                <span>
                  <strong>{w.title}</strong>
                  <span>{w.text}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="steps-intro" aria-labelledby="pasos-titulo">
    <div class="container">
      <h2 id="pasos-titulo" class="section-title dotted">{t.stepsTitle}</h2>
      <p class="section-lead">{t.stepsLead}</p>
      <ol class="step-cards">
        {
          t.steps.map((step, i) => (
            <li class="step-card">
              <Icon name={(["list", "sliders", "receipt"] as const)[i] ?? "list"} class="step-icon" />
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
      <ul class="trust">
        {t.trust.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section id="comparar" class="compare-section" aria-labelledby="comparar-titulo" tabindex="-1">
    <div class="container">
      <p class="eyebrow">{t.compareEyebrow}</p>
      <h2 id="comparar-titulo" class="section-title dotted">{t.compareTitle}</h2>
      <p class="section-lead">{t.compareLead}</p>

      <noscript>
        <p class="callout warning">
          {es.compare.noscript}{" "}
          <a href={routes.services()}>{es.site.nav.services}</a> ·
          <a href={routes.countries()}>{es.site.nav.countries}</a>
        </p>
      </noscript>

      <Comparador
        client:load
        services={services}
        labels={labels}
        riskOptions={riskOptions}
        countryNames={countryNames}
        rates={site.fx.rates}
        fxAsOf={site.fx.as_of}
        residence={site.meta.residence}
        residenceName={site.residenceName}
        residenceCurrency={site.residenceCurrency}
        feePct={site.meta.fx_fee_pct}
        currencies={currencies}
        defaultCurrency={defaultCurrency}
        dataId="comparador-ofertas"
        profiles={profiles}
        defaultProfile={site.feasibility.default_profile}
        residences={residences}
        tieCountries={tieCountries}
        eeaCountries={site.feasibility.eea_countries}
        verdictsId="comparador-veredictos"
        instruments={site.feasibility.instruments}
      />
      <script type="application/json" id="comparador-ofertas" is:inline set:html={offersJson} />
      <script type="application/json" id="comparador-veredictos" is:inline set:html={verdictsJson} />
    </div>
  </section>

  <section class="how-section" aria-labelledby="como-leer">
    <div class="container">
      <h2 id="como-leer" class="section-title dotted">{t.howTitle}</h2>
      <p><a class="button button-ghost" href={routes.methodology()}>{t.howLink}</a></p>
      <ul class="how-grid">
        {
          t.howItems.map((item, i) => (
            <li>
              <Icon name={(["scale", "user", "percent", "lock"] as const)[i] ?? "scale"} />
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<script>
  // The comparator keeps its shareable selection in location.hash, so the "#comparar" CTA
  // scrolls without replacing it; the plain href still works without JavaScript.
  const target = document.getElementById("comparar");
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[href="#comparar"]')) {
    link.addEventListener("click", (event) => {
      if (!target) return;
      event.preventDefault();
      target.scrollIntoView();
      target.focus({ preventScroll: true });
    });
  }
</script>

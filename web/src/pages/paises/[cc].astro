---
import LegacyRedirect from "../../components/LegacyRedirect.astro";
import { getSite } from "../../logic/data";
import { countrySlug, routesFor } from "../../logic/paths";

export function getStaticPaths() {
  return getSite().countries.map((c) => ({ params: { cc: countrySlug(c.cc) } }));
}

const { cc } = Astro.params;
---

<LegacyRedirect to={routesFor("es").country(cc)} />

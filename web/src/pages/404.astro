---
/**
 * GitHub Pages serves this one file for every missing path, in any locale, so it carries the
 * text of all of them and shows the one the URL asks for (English without JavaScript).
 */
import { getMessages } from "../i18n";
import { DEFAULT_LOCALE, LOCALES } from "../i18n/locale";
import Base from "../layouts/Base.astro";
import { routesFor } from "../logic/paths";

const msg = getMessages(DEFAULT_LOCALE);
const titles = Object.fromEntries(
  LOCALES.map((l) => [l, `${getMessages(l).notFound.title} · ${msg.site.name}`]),
);
const base = import.meta.env.BASE_URL;
---

<Base title={msg.notFound.title} indexable={false}>
  {
    LOCALES.map((l) => {
      const m = getMessages(l);
      return (
        <div lang={l} data-not-found={l} hidden={l !== DEFAULT_LOCALE}>
          <h1>{m.notFound.title}</h1>
          <p>{m.notFound.text}</p>
          <p>
            <a href={routesFor(l).home()}>{m.notFound.back}</a>
          </p>
        </div>
      );
    })
  }
</Base>

<script is:inline define:vars={{ base, titles }}>
  const prefix = base.endsWith("/") ? base : `${base}/`;
  const path = location.pathname.startsWith(prefix) ? location.pathname.slice(prefix.length) : "";
  const locale = path.split("/")[0];
  if (titles[locale] && document.querySelector(`[data-not-found="${locale}"]`)) {
    for (const block of document.querySelectorAll("[data-not-found]")) {
      block.hidden = block.getAttribute("data-not-found") !== locale;
    }
    document.documentElement.lang = locale;
    document.title = titles[locale];
  }
</script>

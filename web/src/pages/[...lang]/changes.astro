---
import ChannelBadge from "../../components/ChannelBadge.astro";
import CountryLabel from "../../components/CountryLabel.astro";
import TableWrap from "../../components/TableWrap.astro";
import { getMessages, lookupFor } from "../../i18n";
import Base from "../../layouts/Base.astro";
import { KIND_GROUP_ORDER, QUERY_KEYS, kindGroup } from "../../logic/changesView";
import { getSite } from "../../logic/data";
import { flagEmoji } from "../../logic/format";
import { localeParams, routesFor } from "../../logic/paths";

export function getStaticPaths() {
  return localeParams();
}

const { locale } = Astro.props;
const site = getSite(locale);
const msg = getMessages(locale);
const lookup = lookupFor(msg);
const routes = routesFor(locale);
const { formatDate, formatPercent } = site.fmt;
const t = msg.changes;
const changes = site.recentChanges(90);

// Filter options: only values that appear in the table, so no choice leads to an empty page.
const byName = (a: { name: string }, b: { name: string }) => a.name.localeCompare(b.name, locale);
const serviceOptions = [...new Set(changes.map((c) => c.service_id))]
  .map((id) => ({ value: id, name: site.serviceName(id) }))
  .sort(byName);
const countryOptions = [...new Set(changes.map((c) => c.country))]
  .map((cc) => ({ value: cc, name: site.countryName(cc), flag: flagEmoji(cc) }))
  .sort(byName);
const presentKinds = new Set(changes.map((c) => kindGroup(c.kind, c.pct)));
const kindOptions = KIND_GROUP_ORDER.filter((k) => presentKinds.has(k)).map((k) => ({
  value: k,
  name: t.kindGroups[k] ?? k,
}));
const channelOptions = [...new Set(changes.map((c) => c.channel))]
  .map((ch) => ({ value: ch, name: msg.channels[ch] ?? ch }))
  .sort(byName);

const filters = [
  { field: "service", label: t.colService, options: serviceOptions },
  { field: "country", label: t.colCountry, options: countryOptions },
  { field: "kind", label: t.colKind, options: kindOptions },
  { field: "channel", label: t.colChannel, options: channelOptions },
] as const;
---

<Base title={t.title} current="changes">
  <h1>{t.heading}</h1>
  <p class="lead">{t.lead}</p>
  {
    changes.length === 0 ? (
      <p>{t.empty}</p>
    ) : (
      <div
        class="changes"
        data-changes
        data-locale={locale}
        data-showing={t.showing("{from}", "{to}", "{total}")}
        data-page-label={t.pageLabel(0).replace("0", "{n}")}
        data-previous={t.previous}
        data-next={t.next}
      >
        {/* Filters and pager only work with JavaScript, so they start hidden; without it the
            page lists every row. */}
        <form class="table-filters" aria-label={t.filtersLabel} data-changes-filters hidden>
          {filters.map((f) => (
            <label class="table-filter">
              <span>{f.label}</span>
              <select name={QUERY_KEYS[f.field]} data-field={f.field}>
                <option value="">{t.filterAll}</option>
                {f.options.map((o) => (
                  <option value={o.value}>{"flag" in o && o.flag ? `${o.flag} ${o.name}` : o.name}</option>
                ))}
              </select>
            </label>
          ))}
          <button type="reset" class="link-button table-filters-clear" data-changes-clear>
            {t.clearFilters}
          </button>
        </form>
        <p class="table-count" aria-live="polite" data-changes-count hidden />
        <TableWrap captionId="cambios-caption">
          <table>
            <caption id="cambios-caption">{t.caption}</caption>
            <thead>
              <tr>
                <th scope="col">{t.colDate}</th>
                <th scope="col">{t.colService}</th>
                <th scope="col">{t.colPlan}</th>
                <th scope="col">{t.colCountry}</th>
                <th scope="col">{t.colChannel}</th>
                <th scope="col">{t.colKind}</th>
                <th scope="col" class="num">{t.colOld}</th>
                <th scope="col" class="num">{t.colNew}</th>
                <th scope="col" class="num">{t.colPct}</th>
              </tr>
            </thead>
            <tbody data-changes-rows>
              {changes.map((c) => (
                <tr
                  data-service={c.service_id}
                  data-country={c.country}
                  data-kind={kindGroup(c.kind, c.pct)}
                  data-channel={c.channel}
                >
                  <th scope="row" class="nowrap">
                    <time datetime={c.date}>{formatDate(c.date)}</time>
                  </th>
                  <td>
                    <a href={routes.service(c.service_id)}>{site.serviceName(c.service_id)}</a>
                  </td>
                  <td>{site.planLabel(c.service_id, c.plan_id)}</td>
                  <td>
                    <CountryLabel cc={c.country} />
                  </td>
                  <td>
                    <ChannelBadge channel={c.channel} />
                  </td>
                  <td>{lookup(msg.changeKinds, c.kind)}</td>
                  <td class="num">{site.formatChangeValue(c, c.old)}</td>
                  <td class="num">{site.formatChangeValue(c, c.new)}</td>
                  <td
                    class={`num ${c.pct !== null && c.pct > 0 ? "negative" : c.pct !== null && c.pct < 0 ? "positive" : ""}`}
                  >
                    {formatPercent(c.pct, { signed: true })}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </TableWrap>
        <p class="table-empty" data-changes-empty hidden>
          {t.noMatches}
        </p>
        <nav class="pager" aria-label={t.pagerLabel} data-changes-pager hidden />
      </div>
    )
  }
</Base>

<script>
  import {
    CHANGES_PAGE_SIZE,
    type ChangesFilters,
    type ChangesState,
    matchesFilters,
    pageSlice,
    parseChangesQuery,
    sanitizeFilters,
    toChangesQuery,
  } from "../../logic/changesView";
  import { isLocale } from "../../i18n/locale";
  import { formatFor } from "../../logic/format";
  import { renderPager } from "../../logic/pagerDom";

  const root = document.querySelector<HTMLElement>("[data-changes]");
  if (root) setup(root);

  function setup(root: HTMLElement) {
    const form = root.querySelector<HTMLFormElement>("[data-changes-filters]")!;
    const selects = [...form.querySelectorAll<HTMLSelectElement>("select[data-field]")];
    const count = root.querySelector<HTMLElement>("[data-changes-count]")!;
    const empty = root.querySelector<HTMLElement>("[data-changes-empty]")!;
    const pager = root.querySelector<HTMLElement>("[data-changes-pager]")!;
    const table = root.querySelector<HTMLElement>(".table-wrap")!;
    const rows = [...root.querySelectorAll<HTMLTableRowElement>("[data-changes-rows] > tr")].map((tr) => ({
      tr,
      facets: {
        service: tr.dataset.service ?? "",
        country: tr.dataset.country ?? "",
        kind: tr.dataset.kind ?? "",
        channel: tr.dataset.channel ?? "",
      },
    }));
    const options = Object.fromEntries(
      selects.map((s) => [s.dataset.field, new Set([...s.options].map((o) => o.value).filter(Boolean))]),
    ) as Record<keyof ChangesFilters, Set<string>>;
    const text = (key: string) => root.dataset[key] ?? "";
    const locale = root.dataset.locale;
    const fmt = formatFor(isLocale(locale) ? locale : "en");
    const integer = (n: number) => fmt.formatNumber(n, 0);

    let state: ChangesState = sanitizeFilters(parseChangesQuery(location.search), options);

    function fromForm(): ChangesFilters {
      const filters = { service: "", country: "", kind: "", channel: "" };
      for (const s of selects) filters[s.dataset.field as keyof ChangesFilters] = s.value;
      return filters;
    }

    function render() {
      for (const s of selects) s.value = state[s.dataset.field as keyof ChangesFilters];
      const matching = rows.filter((r) => matchesFilters(r.facets, state));
      const slice = pageSlice(matching.length, state.page, CHANGES_PAGE_SIZE);
      state.page = slice.page;
      const visible = new Set(matching.slice(slice.start, slice.end).map((r) => r.tr));
      for (const r of rows) r.tr.hidden = !visible.has(r.tr);

      const none = matching.length === 0;
      table.hidden = none;
      empty.hidden = !none;
      count.hidden = none;
      count.textContent = text("showing")
        .replace("{from}", integer(slice.start + 1))
        .replace("{to}", integer(slice.end))
        .replace("{total}", integer(matching.length));

      renderPager(pager, slice, (page) => location.pathname + toChangesQuery({ ...state, page }), {
        previous: text("previous"),
        next: text("next"),
        pageLabel: (n) => text("pageLabel").replace("{n}", String(n)),
      });
      form.querySelector<HTMLElement>("[data-changes-clear]")!.hidden = !selects.some((s) => s.value);
    }

    function commit(push: boolean) {
      const url = location.pathname + toChangesQuery(state) + location.hash;
      if (push) history.pushState(null, "", url);
      else history.replaceState(null, "", url);
    }

    form.addEventListener("change", () => {
      state = { ...fromForm(), page: 1 };
      render();
      commit(false);
    });
    form.addEventListener("reset", (event) => {
      event.preventDefault();
      state = { service: "", country: "", kind: "", channel: "", page: 1 };
      render();
      commit(false);
      selects[0]?.focus();
    });
    form.addEventListener("submit", (event) => event.preventDefault());
    pager.addEventListener("click", (event) => {
      const link = (event.target as Element).closest<HTMLAnchorElement>("a[data-page]");
      if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
      event.preventDefault();
      state = { ...state, page: Number(link.dataset.page) };
      render();
      commit(true);
      // Back to the top of the list, where the new page starts.
      form.scrollIntoView({ block: "start" });
      count.focus({ preventScroll: true });
    });
    window.addEventListener("popstate", () => {
      state = sanitizeFilters(parseChangesQuery(location.search), options);
      render();
    });

    count.tabIndex = -1;
    form.hidden = false;
    render();
    // Normalise the URL (stale filters dropped, out-of-range page clamped) without a history entry.
    commit(false);
  }
</script>

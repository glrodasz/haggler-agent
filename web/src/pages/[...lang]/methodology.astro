---
import CountryLabel from "../../components/CountryLabel.astro";
import RiskBadge from "../../components/RiskBadge.astro";
import TableWrap from "../../components/TableWrap.astro";
import { getMessages, lookupFor, profileDescription } from "../../i18n";
import Base from "../../layouts/Base.astro";
import { getSite } from "../../logic/data";
import { AXIS_RANKS, COVERAGE_ORDER } from "../../logic/feasibility";
import { DASH, hostOf, isPdfUrl } from "../../logic/format";
import { localeParams, routesFor } from "../../logic/paths";
import { bundleAnchors, riskClass } from "../../logic/site";

export function getStaticPaths() {
  return localeParams();
}

const { locale } = Astro.props;
const site = getSite(locale);
const msg = getMessages(locale);
const lookup = lookupFor(msg);
const routes = routesFor(locale);
const { formatDate, formatPercent } = site.fmt;
const t = msg.methodology;

const labels = [...site.feasibility.labels].sort((a, b) => a.rank - b.rank);
const axes = (["legality", "tos", "practical"] as const).map((key) => ({
  key,
  info: msg.axes[key],
  values: Object.entries(AXIS_RANKS[key]),
}));

// Coverage: per-service status counts, statuses ordered healthy -> broken.
const coverage = [...site.coverage].sort(
  (a, b) =>
    site.fmt.compareNames(site.serviceName(a.service_id), site.serviceName(b.service_id)) ||
    a.country.localeCompare(b.country) ||
    a.channel.localeCompare(b.channel) ||
    a.adapter_id.localeCompare(b.adapter_id),
);
const present = new Set(coverage.map((r) => r.status));
const statuses = [
  ...COVERAGE_ORDER.filter((s) => present.has(s)),
  ...[...present].filter((s) => !COVERAGE_ORDER.includes(s)).sort(),
];
const serviceIds = [...new Set(coverage.map((r) => r.service_id))];
const counts = serviceIds.map((id) => {
  const rows = coverage.filter((r) => r.service_id === id);
  return {
    id,
    total: rows.length,
    byStatus: Object.fromEntries(statuses.map((s) => [s, rows.filter((r) => r.status === s).length])),
  };
});

const attributions = [...(site.meta.attributions ?? [])];
if (!attributions.some((a) => a.url.includes("tompec"))) attributions.push(t.tompecFallback);

const disclaimer = t.disclaimer(profileDescription(msg, site.meta.profile, site.residenceName));
const research = site.meta.research_run_id
  ? t.researchRun(formatDate(site.meta.research_as_of), site.meta.research_run_id)
  : t.researchRun("", null);

// Bundles: every published one, with what the watcher found of its anchors.
const watched = site.watchedBundles().map((b) => ({ bundle: b, anchors: bundleAnchors(b) }));
const fee = formatPercent(site.meta.fx_fee_pct, { digits: 1 });

const toc = [
  ["recogida", t.collectTitle],
  ["ejes", t.axesTitle],
  ["investigacion", t.researchTitle],
  ["paquetes", t.bundlesTitle],
  ["supuestos", t.assumptionsTitle],
  ["cobertura", t.coverageTitle],
  ["atribuciones", t.attributionsTitle],
  ["aviso-legal", t.disclaimerTitle],
] as const;
---

<Base title={t.title} current="methodology">
  <h1>{t.heading}</h1>
  <p class="lead">{t.lead}</p>

  <nav class="toc" aria-labelledby="toc-title">
    <h2 id="toc-title" class="visually-hidden">{t.toc}</h2>
    <ol>
      {toc.map(([id, title]) => <li><a href={`#${id}`}>{title}</a></li>)}
    </ol>
  </nav>

  <section aria-labelledby="recogida">
    <h2 id="recogida">{t.collectTitle}</h2>
    {
      t.collect.map((item) => (
        <>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </>
      ))
    }
    <p class="callout">{t.feeLine(formatPercent(site.meta.fx_fee_pct))}</p>
  </section>

  <section aria-labelledby="ejes">
    <h2 id="ejes">{t.axesTitle}</h2>
    <p>{t.axesLead}</p>
    <ul class="cards">
      {
        axes.map(({ key, info, values }) => (
          <li class="card">
            <h3>{info?.name}</h3>
            <p class="small muted">{info?.question(site.residenceName)}</p>
            <table>
              <caption class="visually-hidden">{t.axisValueCaption(info?.name ?? key)}</caption>
              <thead>
                <tr>
                  <th scope="col">{t.axisValue}</th>
                  <th scope="col" class="num">{t.axisPoints}</th>
                </tr>
              </thead>
              <tbody>
                {values.map(([value, rank]) => (
                  <tr>
                    <th scope="row">{lookup(info?.values ?? {}, value)}</th>
                    <td class="num">
                      <span class={`badge ${riskClass(rank)}`}>{rank}</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </li>
        ))
      }
    </ul>
    <ul>
      {t.axesRules.map((rule) => <li>{rule}</li>)}
    </ul>

    <h3>{t.labelsTitle}</h3>
    <TableWrap captionId="etiquetas-caption">
      <table>
        <caption id="etiquetas-caption">{t.labelsCaption}</caption>
        <thead>
          <tr>
            <th scope="col" class="num">{t.colLevel}</th>
            <th scope="col">{t.colLabel}</th>
            <th scope="col">{t.colDescription}</th>
          </tr>
        </thead>
        <tbody>
          {
            labels.map((l) => (
              <tr>
                <td class="num">{l.rank >= 0 && l.rank <= 4 ? l.rank : "—"}</td>
                <th scope="row">
                  <RiskBadge label={l.id} rank={l.rank} />
                </th>
                <td>{site.label(l.id, l.rank).description}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </TableWrap>
  </section>

  <section aria-labelledby="investigacion">
    <h2 id="investigacion">{t.researchTitle}</h2>
    <p>{t.researchLead}</p>
    {
      t.research.map((item) => (
        <>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </>
      ))
    }
    <p class="note">{research}</p>

    <h3>{t.profilesTitle}</h3>
    <p>{t.profilesLead}</p>
    <ul>
      {
        site.feasibility.profiles.map((p) => (
          <li>
            <strong>{site.profileName(p.id)}</strong>
            {p.id === site.feasibility.default_profile && (
              <>
                {" "}
                <span class="badge badge-neutral">{t.defaultProfileTag}</span>
              </>
            )}
            {p.description_es && <div class="small muted" lang="es">{p.description_es}</div>}
          </li>
        ))
      }
    </ul>
    <p class="callout warning">{t.researchNotLegal}</p>
  </section>

  <section aria-labelledby="paquetes">
    <h2 id="paquetes">{t.bundlesTitle}</h2>
    <p>{t.bundlesLead}</p>
    {
      t.bundles(fee).map((item) => (
        <>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </>
      ))
    }
    <p class="callout warning">{t.bundlesNotLegal}</p>

    <h3 id="paquetes-vigilados">{t.watchedTitle}</h3>
    <p>{t.watchedLead}</p>
    {
      watched.length === 0 ? (
        <p>{t.watchedEmpty}</p>
      ) : (
        <TableWrap captionId="paquetes-vigilados-caption">
          <table>
            <caption id="paquetes-vigilados-caption">{t.watchedCaption}</caption>
            <thead>
              <tr>
                <th scope="col">{t.colBundle}</th>
                <th scope="col">{t.colCountry}</th>
                <th scope="col">{t.colSource}</th>
                <th scope="col">{t.colWatch}</th>
                <th scope="col">{t.colStatus}</th>
                <th scope="col">{t.colLastCheck}</th>
                <th scope="col" class="num">
                  {t.colAnchors}
                </th>
              </tr>
            </thead>
            <tbody>
              {watched.map(({ bundle: b, anchors }) => (
                <tr>
                  <th scope="row">
                    <a href={routes.bundle(b.country, b.bundle_id)}>{b.name}</a>
                  </th>
                  <td>
                    <CountryLabel cc={b.country} />
                  </td>
                  <td>
                    <a href={b.official_url} rel="nofollow noopener noreferrer external">
                      {hostOf(b.official_url)}
                    </a>
                    {isPdfUrl(b.official_url) && (
                      <>
                        {" "}
                        <span class="badge badge-neutral" title={t.pdfTitle}>
                          {t.pdfTag}
                        </span>
                      </>
                    )}
                  </td>
                  <td>
                    <span title={msg.bundle.watchModeTitles[b.watch_mode]}>
                      {lookup(msg.bundle.watchModes, b.watch_mode)}
                    </span>
                  </td>
                  <td>
                    <span
                      class={`badge status-${b.display_status}`}
                      title={msg.bundle.displayStatusTitles[b.display_status]}
                    >
                      {lookup(msg.bundle.displayStatus, b.display_status)}
                    </span>
                  </td>
                  <td class="nowrap">{formatDate(b.checked_at)}</td>
                  <td class="num">
                    {anchors.total === 0 ? (
                      <>
                        <span aria-hidden="true">{DASH}</span>
                        <span class="visually-hidden">{t.anchorsNone}</span>
                      </>
                    ) : (
                      t.anchors(anchors.verified, anchors.total)
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </TableWrap>
      )
    }
  </section>

  <section aria-labelledby="supuestos">
    <h2 id="supuestos">{t.assumptionsTitle}</h2>
    <p>{t.assumptionsLead}</p>
    <ol>
      {
        t.assumptions(site.residenceName).map((a) => (
          <li>
            <strong>{a.title}.</strong> {a.text}
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="cobertura">
    <h2 id="cobertura">{t.coverageTitle}</h2>
    <p>{t.coverageLead(formatDate(site.meta.as_of))}</p>
    {
      coverage.length === 0 ? (
        <p>{t.coverageEmpty}</p>
      ) : (
        <>
          <TableWrap captionId="cobertura-caption">
            <table>
              <caption id="cobertura-caption">{t.coverageCaption}</caption>
              <thead>
                <tr>
                  <th scope="col">{t.colService}</th>
                  {statuses.map((s) => (
                    <th scope="col" class="num">
                      {lookup(msg.coverageStatus, s)}
                    </th>
                  ))}
                  <th scope="col" class="num">
                    {t.colTotal}
                  </th>
                </tr>
              </thead>
              <tbody>
                {counts.map((c) => (
                  <tr>
                    <th scope="row">
                      <a href={routes.service(c.id)}>{site.serviceName(c.id)}</a>
                    </th>
                    {statuses.map((s) => (
                      <td class="num">{c.byStatus[s] || "—"}</td>
                    ))}
                    <td class="num">{c.total}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </TableWrap>
          <details>
            <summary>{t.coverageDetail}</summary>
            <TableWrap captionId="cobertura-detalle-caption">
              <table>
                <caption id="cobertura-detalle-caption">{t.coverageDetailCaption}</caption>
                <thead>
                  <tr>
                    <th scope="col">{t.colService}</th>
                    <th scope="col">{t.colCountry}</th>
                    <th scope="col">{t.colChannel}</th>
                    <th scope="col">{t.colStatus}</th>
                    <th scope="col">{t.colAdapter}</th>
                    <th scope="col">{t.colFailingSince}</th>
                  </tr>
                </thead>
                <tbody>
                  {coverage.map((r) => (
                    <tr>
                      <th scope="row">{site.serviceName(r.service_id)}</th>
                      <td>
                        <CountryLabel cc={r.country} />
                      </td>
                      <td>{lookup(msg.channels, r.channel)}</td>
                      <td>{lookup(msg.coverageStatus, r.status)}</td>
                      <td>
                        <code>{r.adapter_id}</code>
                      </td>
                      <td class="nowrap">{r.failing_since ? formatDate(r.failing_since) : "—"}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </TableWrap>
          </details>
        </>
      )
    }
  </section>

  <section aria-labelledby="atribuciones">
    <h2 id="atribuciones">{t.attributionsTitle}</h2>
    <p>{t.attributionsLead}</p>
    <ul>
      {
        attributions.map((a) => (
          <li>
            <a href={a.url} rel="noopener noreferrer external">
              {a.name}
            </a>{" "}
            <span class="muted">· {t.license(a.license)}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="aviso-legal" class="callout warning">
    <h2 id="aviso-legal">{t.disclaimerTitle}</h2>
    {disclaimer.map((p) => <p>{p}</p>)}
  </section>
</Base>

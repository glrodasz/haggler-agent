---
import { getSite } from "../logic/data";
import { flagEmoji } from "../logic/format";
import { localeOfUrl, routesFor } from "../logic/paths";

interface Props {
  cc: string;
  link?: boolean;
}

const { cc, link = true } = Astro.props;
const locale = localeOfUrl(Astro.url);
const site = getSite(locale);
const routes = routesFor(locale);
const name = site.countryName(cc);
const known = site.country(cc) !== undefined;
---

<span class="nowrap"
  ><span class="flag" aria-hidden="true">{flagEmoji(cc)}</span>{" "}{
    link && known ? <a href={routes.country(cc)}>{name}</a> : name
  }</span
>

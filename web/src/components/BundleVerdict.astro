---
import { getMessages, localNote, lookupFor } from "../i18n";
import { localeOfUrl } from "../logic/paths";
import { getSite } from "../logic/data";
import type { BundleVerdict } from "../logic/types";
import EuBadge from "./EuBadge.astro";
import RiskBadge from "./RiskBadge.astro";

interface Props {
  verdict: BundleVerdict;
  /** Heading above the verdict (the profile name, or "with pending findings"). */
  title?: string;
}

const { verdict: v, title } = Astro.props;
const locale = localeOfUrl(Astro.url);
const site = getSite(locale);
const msg = getMessages(locale);
const lookup = lookupFor(msg);
const t = msg.bundle;
const f = msg.feasibility;
// "unknown" (facts missing) is one of each axis' values in msg.axes: "Sin datos".
const axis = (name: string, value: string) => lookup(msg.axes[name]?.values ?? {}, value);
const pending = v.provenance === "agent_pending";
const note = localNote(locale, v);
---

<div class={pending ? "verdict is-pending" : "verdict"}>
  {title && <p class="small verdict-title">{title}</p>}
  <p class="badges">
    <RiskBadge label={v.label} rank={v.rank} />
    {v.eu_badge && <EuBadge />}
    <span class={`badge provenance-${v.provenance}`} title={msg.provenanceTitles[v.provenance]}>
      {lookup(msg.provenance, v.provenance)}
    </span>
  </p>
  <dl>
    <dt>{msg.axes.legality?.name}</dt>
    <dd>{axis("legality", v.legality)}</dd>
    <dt>{msg.axes.tos?.name}</dt>
    <dd>{axis("tos", v.tos)}</dd>
    <dt>{msg.axes.practical?.name}</dt>
    <dd>{axis("practical", v.practical)}</dd>
    <dt>{t.verdictConfidence}</dt>
    <dd>{lookup(msg.confidence, v.confidence)}</dd>
    <dt>{t.verdictStatus}</dt>
    <dd>{lookup(msg.curatedStatus, v.status)}</dd>
  </dl>
  {note.text && <p class="small" lang={note.lang}>{note.text}</p>}
  {
    v.reasons_es.length > 0 && (
      <>
        <p class="small evidence-heading">{f.reasonsTitle}</p>
        <ul class="small">
          {v.reasons_es.map((r) => (
            <li lang="es">{r}</li>
          ))}
        </ul>
      </>
    )
  }
  {
    v.assumptions_es.length > 0 && (
      <>
        <p class="small evidence-heading">{f.assumptionsTitle}</p>
        <ul class="small">
          {v.assumptions_es.map((a) => (
            <li lang="es">{a}</li>
          ))}
        </ul>
      </>
    )
  }
  {
    v.components.length > 0 && (
      <>
        <p class="small evidence-heading">{t.perComponent}</p>
        <ul class="small verdict-components">
          {v.components.map((c) => (
            <li>
              {site.serviceName(c.service_id)}: <RiskBadge label={c.label} rank={c.rank} />
              {c.provenance && <span class="muted"> · {lookup(msg.provenance, c.provenance)}</span>}
            </li>
          ))}
        </ul>
      </>
    )
  }
</div>

---
/**
 * The haggler mark: an outstretched hand with a coin dropping into it. One colour
 * (currentColor), so it works in black on white, white on black and in either theme.
 */
interface Props {
  size?: number | string;
  class?: string;
  /** Accessible name; omit for a decorative mark (next to the wordmark). */
  title?: string;
}

const { size = 32, class: className, title } = Astro.props;
---

<svg
  class:list={["logo-mark", className]}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="3"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={title ? "img" : undefined}
  aria-hidden={title ? undefined : "true"}
  aria-label={title}
  focusable="false"
>
  <circle cx="30" cy="12" r="5" fill="currentColor"></circle>
  <path d="M22 30h4a4 4 0 1 0 0-8h-6c-1.2 0-2.2.4-2.8 1.2L6 34"></path>
  <path
    d="m14 42 3.2-2.8c.6-.8 1.6-1.2 2.8-1.2h8c2.2 0 4.2-.8 5.6-2.4l9.2-8.8a4 4 0 0 0-5.5-5.8l-8.4 7.8"
  ></path>
  <path d="m4 32 12 12"></path>
</svg>

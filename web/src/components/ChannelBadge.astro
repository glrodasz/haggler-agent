---
import { getMessages } from "../i18n";
import { localeOfUrl } from "../logic/paths";

const locale = localeOfUrl(Astro.url);
const msg = getMessages(locale);

interface Props {
  channel: string;
}

const { channel } = Astro.props;
---

<span class={`badge channel-${channel}`} title={msg.channelTitles[channel]}>
  {msg.channels[channel] ?? channel}
</span>

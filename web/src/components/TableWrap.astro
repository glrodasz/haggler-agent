---
/**
 * Scrollable, keyboard-reachable container for wide tables (WCAG 2.1.1: a region with
 * tabindex lets keyboard users scroll it). `captionId` must match the table's <caption id>.
 * `stickyHead` keeps the header row below the site header while the page scrolls; the wrapper
 * then stops scrolling sideways, so use it only on tables narrow enough for a phone.
 */
interface Props {
  captionId: string;
  stickyHead?: boolean;
}

const { captionId, stickyHead = false } = Astro.props;
---

<div class:list={["table-wrap", { "has-sticky-head": stickyHead }]} role="region" aria-labelledby={captionId} tabindex="0">
  <slot />
</div>

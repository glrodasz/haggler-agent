---
import { es, lookup } from "../i18n/es";
import { getSite } from "../logic/data";
import { formatDate } from "../logic/format";
import { routes } from "../logic/paths";
import type { FeasibilityView } from "../logic/types";
import { isPending } from "../logic/verdicts";
import CountryLabel from "./CountryLabel.astro";
import EuBadge from "./EuBadge.astro";
import RiskBadge from "./RiskBadge.astro";
import TableWrap from "./TableWrap.astro";

interface Props {
  records: FeasibilityView[];
  /** "service": first column is the target country; "country": the service. */
  mode: "service" | "country";
  caption: string;
  captionId: string;
}

const { records, mode, caption, captionId } = Astro.props;
const site = getSite();
const t = es.service;
const f = es.feasibility;
// "unknown" (facts missing) is one of each axis' values in es.axes: "Sin datos".
const axis = (name: string, value: string) => lookup(es.axes[name]?.values ?? {}, value);
const host = (url: string) => {
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return url;
  }
};
---

<TableWrap captionId={captionId}>
  <table>
    <caption id={captionId}>{caption}</caption>
    <thead>
      <tr>
        <th scope="col">{mode === "service" ? t.colTarget : es.country.colService}</th>
        <th scope="col">{t.colLabel}</th>
        <th scope="col">{es.axes.legality?.name}</th>
        <th scope="col">{es.axes.tos?.name}</th>
        <th scope="col">{es.axes.practical?.name}</th>
        <th scope="col">{t.colConfidence}</th>
        <th scope="col">{t.colStatus}</th>
        <th scope="col">{f.colSource}</th>
        <th scope="col">{t.colNotes}</th>
      </tr>
    </thead>
    <tbody>
      {
        records.map((r) => {
          const details = r.evidence.length + r.assumptions_es.length + r.reasons_es.length > 0;
          return (
            <tr class={isPending(r) ? "is-pending" : undefined}>
              <th scope="row">
                {mode === "service" ? (
                  <CountryLabel cc={r.target_country} />
                ) : (
                  <a href={routes.service(r.service_id)}>{site.serviceName(r.service_id)}</a>
                )}
              </th>
              <td>
                <span class="badges">
                  <RiskBadge label={r.label} rank={r.rank} />
                  {r.eu_badge && <EuBadge />}
                </span>
              </td>
              <td>{axis("legality", r.legality)}</td>
              <td>{axis("tos", r.tos)}</td>
              <td>{axis("practical", r.practical)}</td>
              <td>{lookup(es.confidence, r.confidence)}</td>
              <td>{lookup(es.curatedStatus, r.status)}</td>
              <td>
                <span
                  class={`badge provenance-${r.provenance}`}
                  title={es.provenanceTitles[r.provenance]}
                >
                  {lookup(es.provenance, r.provenance)}
                </span>
                {r.researched_on && (
                  <div class="small muted nowrap">
                    {f.researchedOn(formatDate(r.researched_on))}
                  </div>
                )}
              </td>
              <td class="notes">
                {r.notes_es}
                {r.tos_clause_url && (
                  <div class="small">
                    <a href={r.tos_clause_url} rel="nofollow noopener noreferrer external">
                      {t.tosClause}
                    </a>
                  </div>
                )}
                {details && (
                  <details class="evidence">
                    <summary>{f.evidenceSummary(r.evidence.length)}</summary>
                    {r.evidence.length === 0 ? (
                      <p class="small muted">{f.noEvidence}</p>
                    ) : (
                      <ul class="evidence-list">
                        {r.evidence.map((e) => {
                          const kind = lookup(es.evidenceKinds, e.kind);
                          return (
                            <li>
                              {e.quote && <blockquote cite={e.url}>{e.quote}</blockquote>}
                              <p class="small muted">
                                <a
                                  href={e.url}
                                  rel="nofollow noopener noreferrer external"
                                  aria-label={f.evidenceLinkLabel(host(e.url), kind)}
                                >
                                  {host(e.url)}
                                </a>
                                {" · "}
                                {f.sourceKind(kind)}
                                {e.retrieved_at && (
                                  <> · {f.retrievedOn(formatDate(e.retrieved_at))}</>
                                )}
                                {" · "}
                                {e.verified ? (
                                  <strong class="verified">{f.verifiedQuote}</strong>
                                ) : (
                                  f.unverifiedQuote
                                )}
                              </p>
                            </li>
                          );
                        })}
                      </ul>
                    )}
                    {r.assumptions_es.length > 0 && (
                      <>
                        <p class="small evidence-heading">{f.assumptionsTitle}</p>
                        <ul class="small">
                          {r.assumptions_es.map((a) => (
                            <li>{a}</li>
                          ))}
                        </ul>
                      </>
                    )}
                    {r.reasons_es.length > 0 && (
                      <>
                        <p class="small evidence-heading">{f.reasonsTitle}</p>
                        <ul class="small">
                          {r.reasons_es.map((a) => (
                            <li>{a}</li>
                          ))}
                        </ul>
                      </>
                    )}
                  </details>
                )}
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</TableWrap>

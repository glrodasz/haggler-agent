---
/**
 * The Spanish-only site lived at unprefixed Spanish paths (/servicios/netflix/); they now are the
 * Spanish locale's pages (/es/services/netflix/). These stubs keep old links and bookmarks
 * working: a temporary-style client redirect that keeps the query and the hash, never indexed.
 */
interface Props {
  /** The new page, base included. */
  to: string;
}

const { to } = Astro.props;
const absolute = new URL(to, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Haggler</title>
    <link rel="canonical" href={absolute} />
    <script is:inline define:vars={{ to }}>
      location.replace(to + location.search + location.hash);
    </script>
    <meta http-equiv="refresh" content={`0; url=${to}`} />
  </head>
  <body>
    <p><a href={to}>Haggler</a></p>
  </body>
</html>

# Keep the build context small and free of local state/secrets. The Dockerfile copies only
# pyproject.toml, uv.lock, .python-version, README.md, LICENSE, src/, catalog/, agents/ and
# data/curated/; everything else is excluded here so it never reaches the builder.
.git
.github
.venv
web
tests
.haggler
probe-out
node_modules
**/node_modules

# Local state, caches and secrets
.env
.env.*
**/__pycache__
**/*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov
dist
build
*.egg-info

# Bot-managed data (the job reads its previous state from GCS, not from the image)
data/latest
data/changes

# Not needed at runtime
docs
infra
probe
Dockerfile
.dockerignore
